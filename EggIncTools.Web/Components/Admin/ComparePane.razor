@inject IServiceProvider Services

<p class="wb-note">Read-only across apps. Open an app to change anything.</p>
@if (_report is null) {
    <EmptyState Icon="loader-circle" Title="Reading every app"/>
} else if (_report.Apps.Count == 0) {
    <EmptyState Icon="server" Title="No apps to compare"
                Hint="No suite.apps row has an admin base URL. Set one on the app, then set ADMIN_SECRET_<NAME> on this host for each app."/>
} else {
    <SettingsComparisonPane Report="@_report"/>
}

@code {
    private ComparisonReport? _report;

    protected override async Task OnInitializedAsync() {
        _report = Services.GetService<SettingsComparison>() is { } comparison
            ? await comparison.BuildAsync(refresh: true, CancellationToken.None)
            : ComparisonReport.Empty;
    }
}
