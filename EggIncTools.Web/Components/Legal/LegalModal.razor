<ModalHost Open="@(Kind is not null)" Title="@Title" TitleId="legalModalTitle"
           Width="ModalWidth.Large" OnClose="OnClose">
    <div class="modal-body">
        <LegalHeader/>

        @if (Kind == "privacy") {
            <PrivacyContent OnOpenTerms="@(() => OnKindChange.InvokeAsync("terms"))"/>
        } else if (Kind == "terms") {
            <TermsContent OnOpenPrivacy="@(() => OnKindChange.InvokeAsync("privacy"))"/>
        }
    </div>
</ModalHost>

@code {
    [Parameter] public string? Kind { get; set; }

    [Parameter] public EventCallback<string> OnKindChange { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string Title => Kind == "terms" ? "Terms of Service" : "Privacy & Cookies";
}
