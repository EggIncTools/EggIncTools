<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>EggInc.tools</title>
    <meta name="description" content="@Description"/>
    <link rel="icon" href="@ToolCatalog.HubFaviconUrl" sizes="any"/>
    <link rel="icon" href="@ToolCatalog.HubIconUrl(32)" type="image/png"/>
    <link rel="apple-touch-icon" href="@ToolCatalog.HubIconUrl(180)"/>
    <link rel="canonical" href="@Origin"/>
    <meta name="theme-color" content="#0b0d12"/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="EggInc.tools"/>
    <meta property="og:locale" content="en_US"/>
    <meta property="og:url" content="@Origin"/>
    <meta property="og:title" content="EggInc.tools"/>
    <meta property="og:description" content="@Description"/>
    <meta property="og:image" content="@($"{Origin}/brand/og.png")"/>
    <meta property="og:image:type" content="image/png"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="@ImageAlt"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="EggInc.tools"/>
    <meta name="twitter:description" content="@Description"/>
    <meta name="twitter:image" content="@($"{Origin}/brand/og.png")"/>
    <meta name="twitter:image:alt" content="@ImageAlt"/>
    <link rel="stylesheet" href="/styles.css"/>
    <link rel="stylesheet" href="/EggIncTools.Web.styles.css"/>
    <HeadOutlet @rendermode="@RenderMode"/>
</head>
<body>
<div id="components-reconnect-modal">
    <div class="eit-reconnect-card">
        <p class="eit-reconnect-title">Connection lost</p>
        <p class="eit-reconnect-line eit-reconnect-rejoin">Rejoining EggInc.tools</p>
        <p class="eit-reconnect-line eit-reconnect-wait">
            Attempt <span id="components-reconnect-current-attempt"></span>
            of <span id="components-reconnect-max-retries"></span>.
            Retrying in <span id="components-seconds-to-next-attempt"></span>s.
        </p>
        <p class="eit-reconnect-line eit-reconnect-gone">
            Could not reconnect. <a href="">Reload the page</a> to continue.
        </p>
    </div>
</div>

<Routes @rendermode="@RenderMode"/>
<script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private const string Description =
        "Egg, Inc. fan tools: mission history and drops, game data, and boost math.";

    private const string ImageAlt = "The EggInc.tools front door, with EggInc.tools lettered beside it.";

    private static readonly InteractiveServerRenderMode RenderMode = new(prerender: true);

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string Origin => new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
}
