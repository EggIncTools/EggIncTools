@inherits LayoutComponentBase
@inject IServiceProvider Services

<SuiteSwitcher Placement="SuitePlacement.Bar">
    @if (!HubOnly) {
        <SuiteAccount Placement="SuitePlacement.Bar"/>
    }
</SuiteSwitcher>

<CircuitGuard Name="Page">
    <CascadingValue Value="@_tools">
        @Body
    </CascadingValue>
</CircuitGuard>

<ToastHost/>

@code {
    private IReadOnlyList<ToolCard> _tools = ToolCards.Default;

    private bool HubOnly => Services.GetRequiredService<HostConfig>().HubOnly;

    protected override async Task OnInitializedAsync() {
        if (Services.GetService<ToolRegistry>() is { } registry) _tools = await registry.ToolsAsync();
    }
}
