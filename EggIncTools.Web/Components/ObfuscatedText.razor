<span class="quad-obfuscated" role="img" aria-label="@Announce" style="--glyphs: @Pattern.Length">@for (var i = 0; i < Pattern.Length; i++) {
        if (Pattern[i] == ' ') {
            <span class="quad-gap"> </span>
        } else {
            <span class="quad-cell" style="--cell: @i">@foreach (var face in Faces(Seed + i)) {
                    <span class="quad-face" style="color: @face.Tint">@face.Glyph</span>
                }</span>
        }
    }</span>

@code {
    private const int FaceCount = 6;
    private const int TintOdds = 40;

    private static readonly char[] Glyphs =
        ("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
         + "!?#%&@$*+=/<>~^|;:,.'`()[]{}-_"
         + "ÆÐÞßðþđħłŋœơư"
         + "ΓΔΘΛΞΠΣΦΨΩαβγδε"
         + "ζηθλμξπρστφχψω"
         + "ДЖИЛЦЩЮЯбвджзи"
         + "лфцчшя"
         + "†‡§¶∂∞∫∑∏√≈≠≤≥±÷×"
         + "←↑→↓↔⇒⇔■▲▼◆●★♦♪").ToCharArray();

    private static readonly string[] Tints =
        ["#3b82f6", "#ef7559", "#f43f5e", "#f0b232", "#7aa2ff", "#4ade80", "#c084fc", "#22d3ee"];

    [Parameter] public string Pattern { get; set; } = "";

    [Parameter] public string Announce { get; set; } = "Coming soon";

    private int Seed {
        get {
            var seed = 17;
            foreach (var c in Pattern) seed = seed * 31 + c;
            return seed & 0xffff;
        }
    }

    private static IEnumerable<Face> Faces(int cell) {
        for (var face = 0; face < FaceCount; face++) {
            var tinted = Hash(cell, face + 97) % TintOdds == 0;
            yield return new Face(
                Glyphs[Hash(cell, face) % Glyphs.Length],
                tinted ? Tints[Hash(cell, face + 131) % Tints.Length] : "inherit");
        }
    }

    private sealed record Face(char Glyph, string Tint);

    private static int Hash(int cell, int salt) {
        var h = (uint)((cell + 1) * 2654435761u ^ (uint)(salt * 40503));
        h ^= h >> 15;
        h *= 2246822519u;
        h ^= h >> 13;
        return (int)(h & 0x7fffffff);
    }
}
