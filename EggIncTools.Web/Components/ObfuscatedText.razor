<span class="quad-obfuscated" role="img" aria-label="@Announce" style="--glyphs: @Pattern.Length">@foreach (var cell in Cells) {
        if (cell.Gap) {
            <span class="quad-gap"> </span>
        } else {
            <span class="@CellCss(cell)" style="@CellStyle(cell)">@foreach (var face in Faces(Seed + cell.Index)) {
                    <span class="quad-face" style="color: @face.Tint">@face.Glyph</span>
                }</span>
        }
    }</span>

@code {
    private const int FaceCount = 6;
    private const int TintOdds = 40;
    private const int MinCore = 3;
    private const int MaxOptional = 3;
    private const int FlipMinMs = 900;
    private const int FlipRangeMs = 2400;
    private const int ShrinkMinMs = 3700;
    private const int ShrinkRangeMs = 9100;

    private static readonly char[] Glyphs =
        ("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
         + "!?#%&@$*+=/<>~^|;:,.'`()[]{}-_"
         + "ÆÐÞßðþđħłŋœơư"
         + "ΓΔΘΛΞΠΣΦΨΩαβγδε"
         + "ζηθλμξπρστφχψω"
         + "ДЖИЛЦЩЮЯбвджзи"
         + "лфцчшя"
         + "†‡§¶∂∞∫∑∏√≈≠≤≥±÷×"
         + "←↑→↓↔⇒⇔■▲▼◆●★♦♪").ToCharArray();

    private static readonly string[] Tints =
        ["#3b82f6", "#ef7559", "#f43f5e", "#f0b232", "#7aa2ff", "#4ade80", "#c084fc", "#22d3ee"];

    [Parameter] public string Pattern { get; set; } = "";

    [Parameter] public string Announce { get; set; } = "Coming soon";

    private int Seed {
        get {
            var seed = 17;
            foreach (var c in Pattern) seed = seed * 31 + c;
            return seed & 0xffff;
        }
    }

    private IReadOnlyList<Cell> Cells => BuildCells(Pattern, Seed);

    private static IReadOnlyList<Cell> BuildCells(string pattern, int seed) {
        var cells = new List<Cell>(pattern.Length);
        var word = 0;
        var i = 0;

        while (i < pattern.Length) {
            if (pattern[i] == ' ') {
                cells.Add(new Cell(i, true, 0, -1));
                i++;
                continue;
            }

            var start = i;
            while (i < pattern.Length && pattern[i] != ' ') i++;

            var length = i - start;
            var core = length - OptionalCount(length, Hash(seed + word, 211));
            for (var k = 0; k < length; k++) cells.Add(new Cell(start + k, false, word, k < core ? -1 : k - core));

            word++;
        }

        return cells;
    }

    private static int OptionalCount(int length, int roll) {
        if (length <= MinCore) return 0;
        var headroom = Math.Min(MaxOptional, length - MinCore);
        return roll % (headroom + 1);
    }

    private static string CellCss(Cell cell) => cell.Slot < 0 ? "quad-cell" : "quad-cell quad-cell-opt";

    private string CellStyle(Cell cell) {
        var key = Seed + cell.Index;
        var flip = FlipMinMs + Hash(key, 307) % FlipRangeMs;
        var style = $"--cell: {cell.Index}; --flip: {flip}ms; --flip-lag: -{Hash(key, 409) % flip}ms";
        if (cell.Slot < 0) return style;

        var shrink = ShrinkMinMs + Hash(key, 523) % ShrinkRangeMs;
        return $"{style}; --shrink: {shrink}ms; --shrink-lag: -{Hash(key, 757) % shrink}ms";
    }

    private sealed record Cell(int Index, bool Gap, int Word, int Slot);

    private static IEnumerable<Face> Faces(int cell) {
        for (var face = 0; face < FaceCount; face++) {
            var tinted = Hash(cell, face + 97) % TintOdds == 0;
            yield return new Face(
                Glyphs[Hash(cell, face) % Glyphs.Length],
                tinted ? Tints[Hash(cell, face + 131) % Tints.Length] : "inherit");
        }
    }

    private sealed record Face(char Glyph, string Tint);

    private static int Hash(int cell, int salt) {
        var h = (uint)((cell + 1) * 2654435761u ^ (uint)(salt * 40503));
        h ^= h >> 15;
        h *= 2246822519u;
        h ^= h >> 13;
        return (int)(h & 0x7fffffff);
    }
}
