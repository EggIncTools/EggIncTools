@implements IDisposable

<span class="quad-soon-egg">
    <img class="quad-soon-egg-art" src="/brand/soon/egg-hammer.png" alt="" width="336" height="276" loading="lazy"/>
    <svg class="quad-soon-egg-zzz" viewBox="0 0 84 69" aria-hidden="true" focusable="false">
        @foreach (var puff in _puffs) {
            <g @key="puff.Id" class="egg-z"
               style="font-size: @(puff.Size)px; animation-duration: @(puff.Seconds)s; --dx: @(puff.DriftX)px; --dy: @(puff.DriftY)px; --spin: @(puff.Spin)deg">
                @((MarkupString)$"<text x=\"{puff.X}\" y=\"{puff.Y}\">z</text>")
            </g>
        }
    </svg>
</span>

@code {
    private sealed record Puff(long Id, string X, string Y, string Size, string Seconds, string DriftX, string DriftY, int Spin);

    private static readonly TimeSpan Beat = TimeSpan.FromMilliseconds(250);

    private readonly List<(Puff Puff, int TicksLeft)> _live = [];

    private Timer? _timer;
    private long _next;
    private int _untilSpawn;
    private bool _disposed;

    private IEnumerable<Puff> _puffs => _live.Select(p => p.Puff);

    protected override void OnInitialized() {
        _untilSpawn = 1;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            _timer = new Timer(_ => Tick(), null, Beat, Beat);
        }
    }

    private void Tick() {
        try {
            Advance();
        } catch (ObjectDisposedException) {
            _timer?.Dispose();
        }
    }

    private void Advance() {
        if (_disposed) return;

        var changed = false;

        for (var i = _live.Count - 1; i >= 0; i--) {
            var (puff, ticks) = _live[i];
            if (ticks > 1) {
                _live[i] = (puff, ticks - 1);
                continue;
            }
            _live.RemoveAt(i);
            changed = true;
        }

        if (--_untilSpawn <= 0) {
            _live.Add(Spawn());
            _untilSpawn = Random.Shared.Next(3, 9);
            changed = true;
        }

        if (!changed) return;
        _ = InvokeAsync(StateHasChanged);
    }

    private (Puff, int) Spawn() {
        var seconds = Random.Shared.Next(28, 46) / 10.0;
        var puff = new Puff(
            _next++,
            Fmt(Random.Shared.Next(60, 170) / 10.0),
            Fmt(Random.Shared.Next(-20, 40) / 10.0),
            Fmt(Random.Shared.Next(90, 150) / 10.0),
            Fmt(seconds),
            Fmt(Random.Shared.Next(30, 140) / 10.0),
            Fmt(-Random.Shared.Next(130, 260) / 10.0),
            Random.Shared.Next(-25, 26));

        return (puff, (int)Math.Ceiling(seconds / Beat.TotalSeconds) + 1);
    }

    private static string Fmt(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    public void Dispose() {
        _disposed = true;
        _timer?.Dispose();
    }
}
