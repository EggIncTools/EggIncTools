<span class="quad-soon-egg">
    <img class="quad-soon-egg-art" src="/brand/soon/egg-hammer.png" alt="" width="336" height="276" loading="lazy"/>
    <svg class="quad-soon-egg-zzz" viewBox="0 0 84 69" aria-hidden="true" focusable="false">
        @foreach (var puff in Puffs) {
            <g class="egg-z" style="font-size: @(puff.Size)px; animation-duration: @(puff.Seconds)s; animation-delay: @(puff.Delay)s; --dx: @(puff.DriftX)px; --dy: @(puff.DriftY)px; --spin: @(puff.Spin)deg">
                <text x="@puff.X" y="@puff.Y">z</text>
            </g>
        }
    </svg>
</span>

@code {
    private sealed record Puff(
        string X, string Y, string Size, string Seconds, string Delay, string DriftX, string DriftY, string Spin);

    private static readonly Puff[] Puffs = [
        new("7.4", "1.2", "10.5", "3.4", "0", "5.2", "-17.5", "12"),
        new("12.8", "-0.6", "12.9", "4.1", "1.1", "9.7", "-21.2", "-14"),
        new("9.6", "2.8", "9.4", "3.7", "2.3", "3.8", "-15.4", "21"),
        new("15.2", "0.4", "13.6", "4.4", "3.6", "12.4", "-24.1", "-8"),
        new("6.2", "-1.4", "11.2", "3.1", "4.9", "7.1", "-19.3", "17"),
    ];
}
