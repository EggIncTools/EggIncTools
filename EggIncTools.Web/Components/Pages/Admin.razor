@page "/admin"
@implements IDisposable
@using EggIdentity.Auth
@using EggIdentity.Contract
@using EggIdentity.Suite.AdminUi
@inject IServiceProvider Services
@inject NavigationManager Nav

<PageTitle>Admin - EggInc.tools</PageTitle>

@if (!_checked) {
    <main class="adm"><p class="wb-note">Checking access...</p></main>
} else if (!_isAdmin) {
    <main class="adm">
        <p class="wb-note">
            @(_wasRejected ? "That account is not an administrator, so it has been signed out." : "Admin access required.")
        </p>
        <SignInPanel ReturnUrl="@AdminUrl"/>
    </main>
} else {
    <main class="adm">
        <ToastHost/>
        <header class="adm-head">
            <h1 class="adm-title">Admin</h1>
            <div class="adm-modes">
                <button type="button" class="@ModeCss(Mode.Suite)" @onclick="@(() => _mode = Mode.Suite)">Suite</button>
                <button type="button" class="@ModeCss(Mode.Compare)" @onclick="ShowComparisonAsync">Compare all</button>
                <button type="button" class="@ModeCss(Mode.Fleet)" @onclick="@(() => _mode = Mode.Fleet)">Fleet</button>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="ReloadAsync">
                    <Icon Name="refresh" Class="icon-sm"/>Reload
                </button>
            </div>
        </header>

        @if (_mode == Mode.Fleet) {
            <FleetPanel @key="_generation" OnOpenApps="@(() => _mode = Mode.Suite)"/>
        } else if (_mode == Mode.Compare) {
            <span class="adm-sub">Read-only across apps. Open Suite to change anything.</span>
            @if (_report is null) {
                <p class="wb-note">Reading every app...</p>
            } else if (_report.Apps.Count == 0) {
                <p class="wb-note">
                    No suite.apps row has an admin base URL. Set one in Suite, then set
                    ADMIN_SECRET_&lt;NAME&gt; on this host for each app.
                </p>
            } else {
                <SettingsComparisonPane Report="@_report"/>
            }
        } else {
            <SuitePanel @key="_generation" LocalApp="@LocalApp" IdentityHostApp="@IdentityHostApp" UpdatedBy="@_userId"/>
        }
    </main>
}

@code {
    private enum Mode {
        Suite,
        Compare,
        Fleet,
    }

    private const string LocalApp = "egginctools";
    private const string IdentityHostApp = "eggidentity";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _isAdmin;
    private bool _checked;
    private bool _wasRejected;
    private Mode _mode = Mode.Suite;
    private bool _busy;
    private int _generation;
    private string? _userId;
    private ComparisonReport? _report;
    private DeployToastBridge? _deployToasts;

    private string AdminUrl =>
        Nav.ToAbsoluteUri($"/auth/redeem?returnUrl={Uri.EscapeDataString(Nav.ToAbsoluteUri("/admin").ToString())}").ToString();

    protected override async Task OnInitializedAsync() {
        _wasRejected = Nav.Uri.Contains("rejected=1", StringComparison.Ordinal);

        if (AuthStateTask is not null) {
            var state = await AuthStateTask;
            _isAdmin = state.User.IsAtLeast(UserRole.Admin);
            _userId = state.User.FindFirst("sub")?.Value;

            if (!_isAdmin && !_wasRejected && state.User.Identity is { IsAuthenticated: true }) {
                Nav.NavigateTo("/admin/reject", forceLoad: true);
                return;
            }
        }

        _checked = true;
        if (!_isAdmin) return;

        _deployToasts = Services.GetService<DeployToastBridge>();
        _deployToasts?.Start();
    }

    private async Task ReloadAsync() {
        _busy = true;
        try {
            _generation++;
            _report = null;
            if (_mode == Mode.Compare) await BuildComparisonAsync(refresh: true);
        } finally {
            _busy = false;
        }
    }

    private async Task ShowComparisonAsync() {
        _mode = Mode.Compare;
        if (_report is null) await BuildComparisonAsync(refresh: false);
    }

    private async Task BuildComparisonAsync(bool refresh) {
        _report = Services.GetService<SettingsComparison>() is { } comparison
            ? await comparison.BuildAsync(refresh, CancellationToken.None)
            : ComparisonReport.Empty;
    }

    private string ModeCss(Mode mode) =>
        _mode == mode ? "btn-mini adm-mode adm-mode-on" : "btn-mini adm-mode";

    public void Dispose() => _deployToasts?.Dispose();
}
