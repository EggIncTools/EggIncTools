@page "/admin"
@implements IDisposable
@using EggIdentity.Auth
@using EggIdentity.Contract
@using EggIdentity.Settings.AdminUi
@using EggIdentity.Settings.Api
@using EggIdentity.Settings.Store
@inject IServiceProvider Services
@inject NavigationManager Nav

<PageTitle>Admin - EggInc.tools</PageTitle>

@if (!_checked) {
    <main class="adm"><p class="wb-note">Checking access...</p></main>
} else if (!_isAdmin) {
    <main class="adm">
        <p class="wb-note">
            @(_wasRejected ? "That account is not an administrator, so it has been signed out." : "Admin access required.")
        </p>
        <SignInPanel ReturnUrl="@AdminUrl"/>
    </main>
} else {
    <main class="adm">
        <ToastHost/>
        <header class="adm-head">
            <h1 class="adm-title">Admin</h1>
            <div class="adm-modes">
                <button type="button" class="@ModeCss(Mode.App)" @onclick="@(() => _mode = Mode.App)">One app</button>
                <button type="button" class="@ModeCss(Mode.Compare)" @onclick="ShowComparisonAsync">Compare all</button>
                <button type="button" class="@ModeCss(Mode.Promote)" @onclick="@(() => _mode = Mode.Promote)">Promote</button>
                <button type="button" class="@ModeCss(Mode.Fleet)" @onclick="@(() => _mode = Mode.Fleet)">Fleet</button>
                <button type="button" class="@ModeCss(Mode.Clone)" @onclick="@(() => _mode = Mode.Clone)">Clone</button>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="ReloadAsync">
                    <Icon Name="refresh" Class="icon-sm"/>Reload
                </button>
            </div>
        </header>

        @if (_mode == Mode.Promote) {
            <PromotionPanel UpdatedBy="@_userId"/>
        } else if (_mode == Mode.Fleet) {
            <FleetPanel/>
        } else if (_mode == Mode.Clone) {
            <ClonePanel/>
        } else if (_apps.Count == 0) {
            <p class="wb-note">
                No admin targets are configured. Add rows to the admin.targets collection, then set
                ADMIN_SECRET_&lt;NAME&gt; on this host for each one.
            </p>
        } else if (_mode == Mode.Compare) {
            <span class="adm-sub">Read-only across apps. Pick an app above to change anything.</span>
            @if (_report is null) {
                <p class="wb-note">Reading every target...</p>
            } else {
                <SettingsComparisonPane Report="@_report"/>
            }
        } else {
            <AppSwitcher Apps="@_apps" Selected="@_selected" OnSelect="Select" LocalApp="@LocalApp"/>
            @if (IsLocal) {
                <SettingsPanel UpdatedBy="@_userId" InitialSelection="@AdminTargets.Key"/>
            } else {
                <AppSettingsPane Status="@Current" UpdatedBy="@_userId"/>
            }
        }
    </main>
}

@code {
    private enum Mode {
        App,
        Compare,
        Promote,
        Fleet,
        Clone,
    }

    private const string LocalAppName = "EggIncTools";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _isAdmin;
    private bool _checked;
    private bool _wasRejected;
    private Mode _mode = Mode.App;
    private bool _busy;
    private bool _hasLocalSettings;
    private string? _userId;
    private string? _selected;
    private IReadOnlyList<AdminTargetStatus> _apps = [];
    private ComparisonReport? _report;
    private DeployToastBridge? _deployToasts;

    private string? LocalApp => _hasLocalSettings ? LocalAppName : null;

    private bool IsLocal => _hasLocalSettings && string.Equals(_selected, LocalAppName, StringComparison.Ordinal);

    private string AdminUrl =>
        Nav.ToAbsoluteUri($"/auth/redeem?returnUrl={Uri.EscapeDataString(Nav.ToAbsoluteUri("/admin").ToString())}").ToString();

    private AdminTargetStatus? Current =>
        _apps.FirstOrDefault(a => string.Equals(a.App, _selected, StringComparison.Ordinal));

    protected override async Task OnInitializedAsync() {
        _wasRejected = Nav.Uri.Contains("rejected=1", StringComparison.Ordinal);

        if (AuthStateTask is not null) {
            var state = await AuthStateTask;
            _isAdmin = state.User.IsAtLeast(UserRole.Admin);
            _userId = state.User.FindFirst("sub")?.Value;

            if (!_isAdmin && !_wasRejected && state.User.Identity?.IsAuthenticated == true) {
                Nav.NavigateTo("/admin/reject", forceLoad: true);
                return;
            }
        }

        _checked = true;
        if (!_isAdmin) return;

        _deployToasts = Services.GetService<DeployToastBridge>();
        _deployToasts?.Start();

        _hasLocalSettings = Services.GetService<SettingsAdminService>() is not null;

        if (Services.GetService<AdminTargetsService>() is { } targets) {
            _apps = await targets.StatusesAsync(ct: CancellationToken.None);
        }

        _apps = WithLocal(_apps);
        _selected = LocalApp ?? _apps.FirstOrDefault(a => a.Administrable)?.App;
    }

    private void Select(string app) => _selected = app;

    private IReadOnlyList<AdminTargetStatus> WithLocal(IReadOnlyList<AdminTargetStatus> apps) {
        if (!_hasLocalSettings) return apps;

        var local = new AdminTargetStatus(LocalAppName, AdminTargets.SecretEnvKey(LocalAppName), false, null);
        return [local, .. apps.Where(a => !string.Equals(a.App, LocalAppName, StringComparison.OrdinalIgnoreCase))];
    }

    private async Task ReloadAsync() {
        _busy = true;
        try {
            if (Services.GetService<AdminTargetsService>() is { } targets) {
                _apps = WithLocal(await targets.StatusesAsync(refresh: true, ct: CancellationToken.None));
            }

            if (!IsLocal && Current is null) _selected = LocalApp ?? _apps.FirstOrDefault(a => a.Administrable)?.App;

            _report = null;
            if (_mode == Mode.Compare) await ShowComparisonAsync();
        } finally {
            _busy = false;
        }
    }

    private async Task ShowComparisonAsync() {
        _mode = Mode.Compare;
        if (_report is not null) return;

        if (Services.GetService<SettingsComparison>() is { } comparison) {
            _report = await comparison.BuildAsync(ct: CancellationToken.None);
        }
    }

    private string ModeCss(Mode mode) =>
        _mode == mode ? "btn-mini adm-mode adm-mode-on" : "btn-mini adm-mode";

    public void Dispose() {
        _deployToasts?.Dispose();
    }
}
