@page "/admin"
@implements IDisposable
@using EggIdentity.Auth
@using EggIdentity.Contract
@using EggIncTools.Web.Bot
@using EggIdentity.Suite.AdminUi
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject ICurrentUser Viewer

<PageTitle>Admin - EggInc.tools</PageTitle>

@if (!_checked) {
    <main class="adm"><EmptyState Icon="loader-circle" Title="Checking access" Fill="true"/></main>
} else if (!_isAdmin) {
    <main class="adm">
        @if (_signInFailed) {
            <FaultView Kind="FaultKind.SignInFailed" Scope="FaultScope.Page" Home="false">
                @SignInButtons
            </FaultView>
        } else {
            <EmptyState Icon="lock" Fill="true"
                        Title="@(_wasRejected ? "Not an administrator" : "Admin access required")"
                        Hint="@(_wasRejected ? "That account has been signed out. Sign in with an administrator account." : "Sign in with an administrator account.")">
                @SignInButtons
            </EmptyState>
        }
    </main>
} else {
    <main class="adm">
        <header class="adm-head">
            <h1 class="adm-title">Admin</h1>
            <button type="button" class="btn-mini" title="Reload" aria-label="Reload" @onclick="Reload">
                <Icon Name="refresh" Class="icon-sm"/>
            </button>
        </header>
        <SuitePanel @key="_generation" LocalApp="@LocalApp" IdentityHostApp="@IdentityHostApp" UpdatedBy="@_userId" Extras="@Extras"
                    LocalBot="@LocalBot"/>
    </main>
}

@code {
    private const string LocalApp = "egginctools";
    private const string IdentityHostApp = "eggidentity";

    private static readonly IReadOnlyList<SuiteExtraView> Extras = [
        new("compare", "Compare settings", @<ComparePane/>),
    ];

    private EggIdentity.Bot.IBotConfigAdmin? LocalBot => Services.GetService<HubBot>()?.Bot?.ConfigService;

    private bool _isAdmin;
    private bool _checked;
    private bool _wasRejected;
    private bool _signInFailed;
    private int _generation;
    private string? _userId;
    private DeployToastBridge? _deployToasts;

    private string AdminUrl =>
        Nav.ToAbsoluteUri($"/auth/redeem?returnUrl={Uri.EscapeDataString(Nav.ToAbsoluteUri("/admin").ToString())}").ToString();

    private RenderFragment SignInButtons => @<text>
        @foreach (var provider in SuiteCatalog.Providers) {
            <a class="btn-mini" href="@SuiteCatalog.ProviderSignInUrl(provider, AdminUrl)">
                <Icon Name="@SuiteCatalog.ProviderIcon(provider)"/>
                <span>@ProviderName(provider)</span>
            </a>
        }
    </text>;

    protected override async Task OnInitializedAsync() {
        _wasRejected = Nav.Uri.Contains("rejected=1", StringComparison.Ordinal);
        _signInFailed = Nav.Uri.Contains("signin=failed", StringComparison.Ordinal);

        var user = await Viewer.GetAsync();
        _isAdmin = user.IsAtLeast(UserRole.Admin);
        _userId = user.Id?.ToString();

        if (!_isAdmin && !_wasRejected && user.IsAuthenticated) {
            Nav.NavigateTo("/admin/reject", forceLoad: true);
            return;
        }

        _checked = true;
        if (!_isAdmin) return;

        _deployToasts = Services.GetService<DeployToastBridge>();
        _deployToasts?.Start();
    }

    private void Reload() => _generation++;

    private static string ProviderName(string provider) => provider switch {
        "github" => "GitHub",
        _ => char.ToUpperInvariant(provider[0]) + provider[1..],
    };

    public void Dispose() => _deployToasts?.Dispose();
}
