@page "/"
@implements IDisposable
@inject IServiceProvider Services

<main class="hub">
    <div class="hub-quads">
        @foreach (var card in Tools) {
            var tool = card.Tool;
            var health = _status?.For(tool.Slug);
            <section class="quad quad-@tool.Slug @(tool.Live ? "" : "quad-soon")" style="--tool: @tool.Accent">
                <div class="quad-inner">
                    @if (!tool.Live) {
                        <span class="quad-soon-tag">Coming soon</span>
                        <ConstructionEgg/>
                        <ConstructionLadder/>
                    }
                    <div class="quad-body">
                        <div class="quad-head">
                            <img class="quad-mark" src="@tool.IconUrl(512)" alt="" width="512" height="512" style="@tool.MarkStyle"/>
                            @if (tool.Live) {
                                <a class="quad-name" href="@tool.Url">
                                    <span class="quad-name-text">@tool.Name</span>
                                    <Icon Name="external-link" Class="quad-name-out"/>
                                </a>
                            } else {
                                <span class="quad-name">
                                    <span class="quad-name-text">@tool.Name</span>
                                </span>
                            }
                            @if (health is { State: ToolState.Deploying or ToolState.Failed } state) {
                                <span class="quad-tag quad-tag-@state.State.ToString().ToLowerInvariant()">@state.Label</span>
                            }
                        </div>

                        @if (tool.Live) {
                            <ul class="quad-points">
                                @foreach (var point in card.Points) {
                                    <li>@point</li>
                                }
                            </ul>
                        } else {
                            <div class="quad-pitch">
                                @foreach (var line in ObfuscatedLines) {
                                    <ObfuscatedText Pattern="@line" Announce="@($"{tool.Name} is not announced yet")"/>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <div class="hub-core">
            <h1 class="hub-title">EggInc<span class="hub-title-dot">.</span>tools</h1>

            <p class="hub-by">
                <span>Proudly presented by</span>
                <a class="hub-chip" href="@HubLinks.GitHubUrl" target="_blank" rel="noopener">
                    <img class="hub-chip-mark" src="@Brands.IconPath("tools", 512)" alt="" width="512" height="512"/>
                    <span>EggIncTools</span>
                </a>
                <span>&amp;</span>
                <a class="hub-chip hub-chip-author" href="@HubLinks.AuthorUrl" target="_blank" rel="noopener">
                    <Icon Name="brand-github"/>
                    <span>@HubLinks.AuthorName</span>
                </a>
            </p>

            <a class="hub-invite" href="@HubLinks.DiscordUrl" target="_blank" rel="noopener">
                <img class="hub-invite-mark" src="@HubLinks.DiscordIconUrl" alt="" width="64" height="64" loading="lazy"/>
                <span class="hub-invite-body">
                    <span class="hub-invite-sub">@HubLinks.DiscordName</span>
                    <span class="hub-invite-name">Join the Discord Server</span>
                    <span class="hub-invite-points">
                        <span>General discussion &amp; tool support</span>
                        <span>Notifications for protos/game changes</span>
                        <span>Discord features for supported apps</span>
                    </span>
                </span>
                <span class="hub-invite-cta">Join<Icon Name="arrow-right"/></span>
            </a>
        </div>
    </div>

    <footer class="hub-foot">
        <nav class="hub-foot-links">
            <a href="/privacy" @ref="_privacyLink" @onclick="@(() => OpenLegal("privacy", _privacyLink))" @onclick:preventDefault>
                <Icon Name="file-text"/>Privacy
            </a>
            <a href="/terms" @ref="_termsLink" @onclick="@(() => OpenLegal("terms", _termsLink))" @onclick:preventDefault>
                <Icon Name="file-text"/>Terms
            </a>
        </nav>
        <p class="hub-disclaimer">
            <span>Independent, fan-made, and not affiliated with, endorsed by, or sponsored by Auxbrain Inc.</span>
            <span>Egg, Inc. and related marks are the property of their respective owners.</span>
        </p>
    </footer>
</main>

<LegalModal Kind="@_legal" OnKindChange="@(kind => _legal = kind)" OnClose="@(() => _legal = null)" ReturnFocusTo="@_legalOpener"/>

@code {
    private static readonly string[] ObfuscatedLines = [
        "xxxxxxx xxxxx xxxxx xxx xxxxxx xxxxx xxxx",
        "xxxxxxx xxxx xxxxxx xxxxx xxx xxxxxxxx",
    ];

    [CascadingParameter] public IReadOnlyList<ToolCard> Tools { get; set; } = ToolCards.Default;

    private string? _legal;
    private ElementReference _privacyLink;
    private ElementReference _termsLink;
    private ElementReference? _legalOpener;
    private ToolStatusService? _status;

    protected override void OnInitialized() {
        _status = Services.GetService<ToolStatusService>();
        if (_status is not null) _status.Changed += OnStatusChanged;
    }

    public void Dispose() {
        if (_status is not null) _status.Changed -= OnStatusChanged;
    }

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    private void OpenLegal(string kind, ElementReference opener) {
        _legal = kind;
        _legalOpener = opener;
    }
}
