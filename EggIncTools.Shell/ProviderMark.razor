@switch (Provider) {
    case "google":
        <svg class="icon icon-xs eit-mark-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="@_stripeId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#ea4335"/>
                    <stop offset="25%" stop-color="#ea4335"/>
                    <stop offset="25%" stop-color="#fbbc05"/>
                    <stop offset="50%" stop-color="#fbbc05"/>
                    <stop offset="50%" stop-color="#34a853"/>
                    <stop offset="75%" stop-color="#34a853"/>
                    <stop offset="75%" stop-color="#4285f4"/>
                    <stop offset="100%" stop-color="#4285f4"/>
                </linearGradient>
            </defs>
            <path fill="url(#@_stripeId)" d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
        </svg>
        break;
    case "microsoft":
        <svg class="icon icon-xs eit-mark-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="2" y="2" width="9" height="9" fill="#f25022"/>
            <rect x="13" y="2" width="9" height="9" fill="#7fba00"/>
            <rect x="2" y="13" width="9" height="9" fill="#00a4ef"/>
            <rect x="13" y="13" width="9" height="9" fill="#ffb900"/>
        </svg>
        break;
    default:
        <Icon Name="@ToolCatalog.ProviderIcon(Provider)" Class="icon-xs"/>
        break;
}

@code {
    private readonly string _stripeId = $"eit-google-stripes-{Guid.NewGuid():N}";

    [Parameter] public string Provider { get; set; } = "";
}
